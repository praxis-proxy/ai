# Ignore build artifacts and generated files
target/

# Ignore documentation
.*
docs/
*.md
LICENSE*

# ...but ship the legal files the runtime image must carry (Apache-2.0 section 4)
!LICENSE
!NOTICE
!integrations/llmd/ext-proc/NOTICE

# Ignore fmt, lint and deny configs
rustfmt.toml
deny.toml

# Ignore devtools and examples. The test crates and xtask stay in the context:
# they are workspace members, and Containerfile.fips builds with --locked
# against the whole workspace and runs `cargo xtask fips` in its report stage.
Makefile
examples/
benchmarks/
